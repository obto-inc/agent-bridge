{
  "manifest_version": 3,
  "name": "OBTO agent",
  "version": "0.1.0",
  "description": "Lets your OBTO agent read and act in its own tab group in your Chrome, as you, on sites you allow. Linked through the OBTO bridge on this computer.",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "OBTO agent",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "116"
}
